# Copy to .env and fill in. Never commit .env.

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-southeast1
# Path to a service-account key for local dev (optional; prefer `gcloud auth application-default login`)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# --- Gemini (Google Gen AI SDK) ---
# true  -> use Vertex AI with the project/location above (recommended for deploys)
# false -> use an AI Studio API key
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase (only if we use it) ---
FIREBASE_PROJECT_ID=

# --- App ---
APP_ENV=development
PORT=8080
